							]
						}
					],
					"fontFamily": "\"Inter\", sans-serif",
					"name": "Inter",
					"slug": "body"
				},
				{
					"fontFace": [
						{
							"fontFamily": "NeutralFace",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": ["file:./assets/fonts/NeutralFace/NeutralFaceBold.woff2"]
						}
					],
