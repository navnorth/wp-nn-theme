{
	"$schema": "https://schemas.wp.org/wp/6.5/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{
					"color": "#FFFFFF",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#323940",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#1C73BB",
					"name": "Blue",
					"slug": "blue"
				},
				{
					"color": "#0F5C9C",
					"name": "Blue Dark",
					"slug": "blue-dark"
				},
				{
					"color": "#F0F8FF",
					"name": "Blue Light",
					"slug": "blue-light"
				},
				{
					"color": "#26A1C6",
					"name": "Cyan",
					"slug": "cyan"
				},
				{
					"color": "#EFFCFF",
					"name": "Cyan Light",
					"slug": "cyan-light"
				},
				{
					"color": "#FCC94D",
					"name": "Yellow",
					"slug": "yellow"
				},
				{
					"color": "#FFFCED",
					"name": "Yellow Light",
					"slug": "yellow-light"
				},
				{
					"color": "#172836",
					"name": "Black",
					"slug": "black"
				},
				{
					"color": "#F9FAFB",
					"name": "Gray Light",
					"slug": "gray"
				}
			]
		},
		"layout": {
			"contentSize": "620px",
			"wideSize": "1280px"
		},
		"spacing": {
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"name": "1",
					"size": "1rem",
					"slug": "10"
				},
				{
					"name": "2",
					"size": "min(1.5rem, 2vw)",
					"slug": "20"
				},
				{
					"name": "3",
					"size": "min(2.5rem, 3vw)",
					"slug": "30"
				},
				{
					"name": "4",
					"size": "min(4rem, 5vw)",
					"slug": "40"
				},
				{
					"name": "5",
					"size": "min(6.5rem, 8vw)",
					"slug": "50"
				},
				{
					"name": "6",
					"size": "min(10.5rem, 13vw)",
					"slug": "60"
				}
			],
			"units": ["%", "px", "em", "rem", "vh", "vw"]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStretch": "normal",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/inter/Inter-VariableFont_slnt,wght.woff2"
							]
						}
					],
					"fontFamily": "\"Inter\", sans-serif",
					"name": "Inter",
					"slug": "body"
				},
				{
					"fontFace": [
						{
							"fontFamily": "NeutralFace",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": ["file:./assets/fonts/NeutralFace/NeutralFaceBold.woff2"]
						}
					],
					"fontFamily": "NeutralFace",
					"name": "NeutralFace",
					"slug": "heading"
				}
			],
			"fontSizes": [
				{
					"name": "H1",
					"size": "64px",
					"slug": "xx-large"
				},
				{
					"name": "H2",
					"size": "45px",
					"slug": "x-large"
				},
				{
					"name": "H3",
					"size": "35px",
					"slug": "large"
				},
				{
					"fluid": false,
					"name": "H4",
					"size": "23px",
					"slug": "medium"
				},
				{
					"fluid": false,
					"name": "H5",
					"size": "20px",
					"slug": "h5"
				},
				{
					"fluid": false,
					"name": "H6",
					"size": "18px",
					"slug": "small"
				},
				{
					"fluid": false,
					"name": "Body",
					"size": "19px",
					"slug": "body"
				}
			],
			"writingMode": true
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"blocks": {
			"core/button": {
				"variations": {
					"nn-blue": {
						"color": {
							"background": "var(--wp--preset--color--blue)",
							"text": "var(--wp--preset--color--base)"
						}
					},
					"nn-cyan": {
						"color": {
							"background": "var(--wp--preset--color--cyan)",
							"text": "var(--wp--preset--color--base)"
						}
					},
					"nn-yellow": {
						"color": {
							"background": "var(--wp--preset--color--yellow)",
							"text": "var(--wp--preset--color--black)"
						}
					}
				},
				"spacing": {
					"padding": {
						"top": "10px",
						"bottom": "10px",
						"left": "20px",
						"right": "20px"
					}
				},
				"border": {
					"radius":{
						"bottomLeft":"100px",
						"bottomRight": "100px",
						"topLeft": "100px",
						"topRight": "100px"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "16px",
					"fontStyle": "normal",
					"fontWeight": "700",
					"textTransform": "uppercase",
					"lineHeight": "130%",
					"letterSpacing": "0.96px"
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"button": {
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--blue)",
						"text": "var(--wp--preset--color--base)"
					},
					"border": {
						"color": "var(--wp--preset--color--blue)"
					}
				},
				"border": {
					"radius": ".33rem",
					"color": "var(--wp--preset--color--cyan)"
				},
				"color": {
					"background": "var(--wp--preset--color--cyan)",
					"text": "var(--wp--preset--color--base)"
				},
				"spacing": {
					"padding": {
						"bottom": "0.6rem",
						"left": "1rem",
						"right": "1rem",
						"top": "0.6rem"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontStyle": "normal",
					"fontWeight": "500"
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--contrast-2)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "0.8rem"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.2em",
                    "letterSpacing": "0.04em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
                    "lineHeight": "1.2em",
                    "letterSpacing": "0.04em"
				},
                "css": ".lg{font-size:var(--wp--preset--font-size--xx-large);line-height:1.2em;letter-spacing:0.04em;}"
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
                    "lineHeight": "1.2em",
                    "letterSpacing": "0.03em"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
                    "lineHeight": "1.3em",
                    "letterSpacing": "0.02em"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h-5)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "400",
					"lineHeight": "1.2em"
				}
			},
			"link": {
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			}
		},
		"spacing": {
			"blockGap": "1.2rem",
			"padding": {
				"left": "var(--wp--preset--spacing--50)",
				"right": "var(--wp--preset--spacing--50)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"fontStyle": "normal",
			"fontWeight": "400",
			"lineHeight": "1.4em"
		},
		"css": ":where(.wp-site-blocks *:focus){outline-width:2px;outline-style:solid}.body1{font-size:var(--wp--preset--font-size--body-1);}.body2{font-size:var(--wp--preset--font-size--body-2);line-height:1.5em;}.body3{font-size:var(--wp--preset--font-size--body-3);line-height:1.5em;letter-spacing:0.005em;}.eyebrow{font-size:var(--wp--preset--font-size--eyebrow);line-height:1.4em;letter-spacing:0.12em;}"
	}
}