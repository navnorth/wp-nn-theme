	"styles": {
		"blocks": {
			"core/button": {
				"variations": {
					"nn-blue": {
						"color": {
							"background": "var(--wp--preset--color--default)",
							"text": "var(--wp--preset--color--paper)"
						}
					},
					"nn-cyan": {
						"color": {
							"background": "var(--wp--preset--color--cyan)",
							"text": "var(--wp--preset--color--paper)"
						}
					},
					"nn-yellow": {
						"color": {
							"background": "var(--wp--preset--color--mango)",
							"text": "var(--wp--preset--color--text-primary)"
						}
					}
				},
				"spacing": {
					"padding": {
						"top": "10px",
						"bottom": "10px",
						"left": "20px",
						"right": "20px"
					}
				},
				"border": {
					"radius":{
						"bottomLeft":"100px",
						"bottomRight": "100px",
						"topLeft": "100px",
						"topRight": "100px"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "16px",
					"fontStyle": "normal",
					"fontWeight": "700",
					"textTransform": "uppercase",
					"lineHeight": "130%",
					"letterSpacing": "0.96px"
				}
			},
			"core/navigation": {
				"elements": {
					"link": {
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						},
						"typography": {
							"textDecoration": "none",
							"fontSize":"var(--wp--preset--font-size--menu)",
							"fontFamily":"var(--wp--preset--font-family--body)",
							"fontStyle":"normal",
							"fontWeight":"600",
							"lineHeight":"1.3em"
						}
					}
				},
				"typography": {
					"fontWeight": "500"
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--dark-gray)"
		},
		"elements": {
			"button": {
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--default)",
						"text": "var(--wp--preset--color--paper)"
					},
					"border": {
						"color": "var(--wp--preset--color--default)"
					}
				},
				"border": {
					"radius": ".33rem",
					"color": "var(--wp--preset--color--cyan)"
				},
				"color": {
					"background": "var(--wp--preset--color--cyan)",
					"text": "var(--wp--preset--color--paper)"
				},
				"spacing": {
					"padding": {
						"bottom": "0.6rem",
						"left": "1rem",
						"right": "1rem",
						"top": "0.6rem"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontStyle": "normal",
					"fontWeight": "500"
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--default)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "0.8rem"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.2em",
                    "letterSpacing": "0.04em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
                    "lineHeight": "1.2em",
                    "letterSpacing": "0.04em"
				},
                "css": ".lg{font-size:var(--wp--preset--font-size--xx-large);line-height:1.2em;letter-spacing:0.04em;}"
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
                    "lineHeight": "1.2em",
                    "letterSpacing": "0.03em"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
                    "lineHeight": "1.3em",
                    "letterSpacing": "0.02em"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h-5)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--dark-gray)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "400",
					"lineHeight": "1.2em"
				}
			},
			"link": {
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--dark-gray)"
				}
			}
		},
		"spacing": {
			"blockGap": "1.2rem",
			"padding": {
				"left": "var(--wp--preset--spacing--50)",
				"right": "var(--wp--preset--spacing--50)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"fontStyle": "normal",
			"fontWeight": "400",
			"lineHeight": "1.4em"
		},
		"css": ":where(.wp-site-blocks *:focus){outline-width:2px;outline-style:solid}.body1{font-size:var(--wp--preset--font-size--body-1);}.body2{font-size:var(--wp--preset--font-size--body-2);line-height:1.5em;}.body3{font-size:var(--wp--preset--font-size--body-3);line-height:1.5em;letter-spacing:0.005em;}.eyebrow{font-size:var(--wp--preset--font-size--eyebrow);line-height:1.4em;letter-spacing:0.12em;}"
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		}
	]
}